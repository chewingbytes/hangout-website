      compatible: ["ESFJ", "ESTJ", "ENFJ"],
      hangoutStyle: "ISFPs are the ones who bring a film camera, notice the golden hour light, and wander off to explore while everyone else is still deciding where to eat. You'll find them, and the photos are always stunning.",
    },
    ESTP: {
      type: "ESTP",
      label: "The Thrill-Seeker",
      emoji: "⚡",
      colorHex: "#f0abfc",
      group: "Explorers",
      tagline: "Action first. Questions never.",
      overview: "ESTPs are born to be in the thick of it. Bold, energetic, and endlessly entertaining, they read every social situation like a chessboard and adapt in real time. They don't plan for the moment, they are the moment. The energy in the room shifts the second they walk in.",
      letters: [
        { letter: "E", full: "Extrovert", desc: "Social & bold" },
        { letter: "S", full: "Sensing", desc: "Lives in the now" },
        { letter: "T", full: "Thinking", desc: "Pragmatic & direct" },
        { letter: "P", full: "Perceiving", desc: "Improvises brilliantly" },
      ],
      traits: ["Bold", "Energetic", "Direct", "Perceptive", "Sociable", "Adaptable", "Risk-taker", "Practical"],
      strengths: [
        "Exceptionally good at reading social situations in real-time",
        "Natural persuader and negotiator",
        "Thrives in fast-paced, high-pressure environments",
        "Bold and decisive, and acts when others hesitate",
        "Highly observant of their physical environment",
      ],
      growth: [
        "Impatient and restless when things slow down",
        "Takes risks without thinking through the consequences",
        "Can come off as blunt or insensitive",
        "Struggles with long-term planning",
        "Gets bored with deep theoretical discussions",
      ],
      famous: [
        { name: "Samuel L. Jackson", role: "Actor" },
        { name: "Madonna", role: "Singer" },
        { name: "Mike Tyson", role: "Boxer" },
        { name: "Ernest Hemingway", role: "Author" },
      ],
      compatible: ["ISFJ", "ISTJ", "ESFJ"],
      hangoutStyle: "ESTPs are the energy of the event. They'll drag you into something spontaneous, talk their way past any awkward situation, and make sure it becomes a night you're still talking about months later.",
    },
    ESFP: {
      type: "ESFP",
      label: "The Entertainer",
      emoji: "🎉",
      colorHex: "#f9a8d4",
      group: "Explorers",
      tagline: "Life is a stage. Enter: you.",
      overview: "ESFPs are the ultimate good time. Joyful, spontaneous, and magnetic, they don't just enjoy life, they perform it. Every moment with an ESFP is an invitation to drop what's boring and fully embrace what's real. They make ordinary days feel like events.",
      letters: [
        { letter: "E", full: "Extrovert", desc: "Loves the spotlight" },
        { letter: "S", full: "Sensing", desc: "Lives in the moment" },
        { letter: "F", full: "Feeling", desc: "Emotionally expressive" },
        { letter: "P", full: "Perceiving", desc: "Spontaneous" },
      ],
      traits: ["Fun", "Spontaneous", "Sociable", "Energetic", "Practical", "Expressive", "Observant", "Charming"],
      strengths: [
        "Naturally magnetic, and people gravitate to them",
        "Fully lives in the present moment",
        "Highly adaptable and fun in literally any situation",
        "Warm and genuinely interested in everyone they meet",
        "Surprisingly practical and quick-thinking in a real crisis",
      ],
      growth: [
        "Avoids hard truths and difficult conversations",
        "Struggles with any kind of long-term planning",
        "Sensitive to conflict and criticism",
        "Can be unfocused and easily distracted",
        "May prioritize fun over responsibility",
      ],
      famous: [
        { name: "Adele", role: "Singer" },
        { name: "Jamie Foxx", role: "Actor & Comedian" },
        { name: "Miley Cyrus", role: "Singer & Actress" },
        { name: "Serena Williams", role: "Tennis Legend" },
      ],
      compatible: ["ISTJ", "ISFJ", "ESTJ"],
      hangoutStyle: "ESFPs turn any group hangout into a performance and any casual meetup into the highlight of your month. The energy is contagious, and the stories are always legendary.",
    },
  };

  return Object.entries(allMbtiData).map(([type, data]) => ({
    params: { type },
    props: { mbti: data },
  }));
}

const { mbti } = Astro.props as { mbti: MbtiData };

// Build the color map for compatible type pills
const mbtiHexMap: Record<string, string> = {
  INTJ: "#fca5a5", INTP: "#fdba74", ENTJ: "#fcd34d", ENTP: "#fde047",
  INFJ: "#bef264", INFP: "#86efac", ENFJ: "#6ee7b7", ENFP: "#5eead4",
  ISTJ: "#67e8f9", ISFJ: "#7dd3fc", ESTJ: "#93c5fd", ESFJ: "#a5b4fc",
  ISTP: "#c4b5fd", ISFP: "#d8b4fe", ESTP: "#f0abfc", ESFP: "#f9a8d4",
};

const mbtiLabelMap: Record<string, string> = {
  INTJ: "The Strategist", INTP: "The Thinker", ENTJ: "The Commander", ENTP: "The Debater",
  INFJ: "The Advocate", INFP: "The Mediator", ENFJ: "The Mentor", ENFP: "The Connector",
  ISTJ: "The Inspector", ISFJ: "The Protector", ESTJ: "The Executive", ESFJ: "The Consul",
  ISTP: "The Virtuoso", ISFP: "The Creator", ESTP: "The Thrill-Seeker", ESFP: "The Entertainer",
};

const allTypes = ["INTJ","INTP","ENTJ","ENTP","INFJ","INFP","ENFJ","ENFP","ISTJ","ISFJ","ESTJ","ESFJ","ISTP","ISFP","ESTP","ESFP"];
---

<Layout title={`${mbti.type} — ${mbti.label} | Hangout!`}>

  <!-- ─── WAITLIST MODAL ──────────────────────────────────────────── -->
  <dialog
    id="waitlist-modal"
    class="border-4 border-black max-w-md w-full mx-4"
  >
    <div class="bg-neo-bg p-8 relative">
      <div
        class="absolute -top-5 -right-5 w-12 h-12 border-4 border-black rotate-12 flex items-center justify-center shadow-neo"
        style={`background-color: ${mbti.colorHex}`}
      >
        <Sparkles className="w-6 h-6" />
      </div>
      <button
        id="close-waitlist"
        class="absolute top-4 right-4 w-10 h-10 border-4 border-black bg-white flex items-center justify-center font-black text-xl hover:bg-red-400 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all shadow-neo"
        aria-label="Close">✕</button
      >

      <div class="mb-6">
        <div
          class="inline-block border-2 border-black px-3 py-1 font-black text-xs uppercase tracking-widest mb-3 -rotate-1"
          style={`background-color: ${mbti.colorHex}`}
        >
          🇸🇬 Students Only
        </div>
        <h2 class="text-4xl font-black uppercase leading-none mb-2">
          Join the Waitlist
        </h2>
        <p class="font-bold text-lg">
          Get early access when Hangout! launches.
        </p>
      </div>

      <div class="border-4 border-black p-4 mb-6" style={`background-color: ${mbti.colorHex}`}>
        <div class="flex items-center gap-2 mb-1">
          <ShieldCheck className="w-5 h-5" />
          <span class="font-black uppercase text-sm">Use Your School Email</span>
        </div>
        <p class="font-medium text-sm">
          Enter your official school email (e.g. <code class="bg-black text-white px-1 font-mono">you@tp.edu.sg</code>).
        </p>
      </div>

      <form id="waitlist-form" class="space-y-4">
        <div>
          <label class="block font-black uppercase text-sm mb-2 tracking-wider">School Email Address</label>
          <input
            type="email"
            id="waitlist-email"
            placeholder="yourname@school.edu.sg"
            required
            class="w-full border-4 border-black p-4 font-bold text-lg bg-white focus:outline-none focus:shadow-neo transition-all placeholder:text-black/30"
          />
          <p class="text-xs font-bold mt-1 text-black/50">Must be a .edu.sg email, no personal emails allowed</p>
        </div>

        <div>
          <label class="block font-black uppercase text-sm mb-2 tracking-wider">
            What are you into? <span class="text-black/50 normal-case font-bold text-xs ml-1">(Optional)</span>
          </label>
          <div class="max-h-40 overflow-y-auto border-4 border-black p-3 bg-neo-bg mb-2 [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:bg-black [&::-webkit-scrollbar-track]:bg-white">
            <div class="flex flex-wrap gap-2">
              {[
                "Badminton 🏸", "Bouldering 🧗", "Cafe Hopping ☕", "Coding & Tech 💻",
                "Midnight Prata 🍛", "PC Gaming 🎮", "Mobile Gaming 📱", "Board Games 🎲",
                "Photography 📸", "Thrift Shopping 👕", "Running 🏃", "Study Grinding 📚",
                "Side Hustles 🚀", "Anime/Cosplay 🎭", "Music/Jamming 🎸",
              ].map((item) => (
                <label class="cursor-pointer relative">
                  <input type="checkbox" name="communities" value={item} class="peer sr-only" />
                  <span class="block px-3 py-1 text-sm font-bold border-2 border-black bg-neo-muted peer-checked:bg-neo-primary peer-checked:text-black transition-all select-none">
                    {item}
                  </span>
                </label>
              ))}
            </div>
          </div>
          <input
            type="text"
            id="custom-community"
            placeholder="Other? Type here... (Optional)"
            class="w-full border-4 border-black p-3 font-bold text-sm bg-white focus:outline-none focus:shadow-neo transition-all placeholder:text-black/30"
          />
        </div>

        <button
          type="submit"
          class="w-full border-4 border-black py-4 font-black text-xl uppercase tracking-wider hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all shadow-neo-md flex items-center justify-center gap-3"
          style={`background-color: ${mbti.colorHex}`}
        >
          <Zap className="w-6 h-6 fill-black" />
          Secure My Spot
        </button>
      </form>

      <div id="waitlist-success" class="hidden text-center py-6">
        <div class="text-5xl mb-4">🎉</div>
        <h3 class="text-3xl font-black uppercase mb-2">You're on the list!</h3>
        <p class="font-bold text-lg">We'll hit your inbox the moment we launch.</p>
      </div>
    </div>
  </dialog>

  <!-- ─── NAV ─────────────────────────────────────────────────────── -->
  <nav class="sticky top-0 z-50 bg-neo-bg border-b-4 border-black px-4 py-3">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="/" class="flex items-center gap-1 font-black uppercase tracking-tighter text-2xl">
        <img src={logo.src} alt="Hangout!" class="w-20 h-auto object-contain" />
        Hangout!
      </a>
      <div class="flex items-center gap-3">
        <a
          href="/#show-up"
          class="flex items-center gap-2 font-black uppercase text-sm border-4 border-black bg-white px-4 py-2 hover:bg-black hover:text-white transition-colors shadow-neo"
        >
          <ArrowLeft className="w-4 h-4" />
          Back
        </a>
        <a
          href="/communities"
          class="hidden md:block font-black uppercase text-sm border-4 border-black px-4 py-2 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all shadow-neo"
          style={`background-color: ${mbti.colorHex}`}
        >
          Communities
        </a>
      </div>
    </div>
  </nav>

  <!-- ─── HERO ──────────────────────────────────────────────────────── -->
  <section
    class="relative overflow-hidden border-b-4 border-black min-h-[85vh] flex items-center"
    style={`background-color: ${mbti.colorHex}`}
  >
    <!-- dot grid pattern -->
    <div
      class="absolute inset-0 pointer-events-none opacity-20"
      style="background-image: radial-gradient(#000 1.5px, transparent 1.5px); background-size: 28px 28px;"
    ></div>

    <!-- decorative corner block -->
    <div class="absolute top-0 right-0 w-40 h-40 bg-black border-l-4 border-b-4 border-black hidden lg:flex items-center justify-center">
      <span class="text-6xl rotate-12 select-none">{mbti.emoji}</span>
    </div>
    <div class="absolute bottom-0 left-0 w-24 h-24 bg-black hidden lg:block"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 py-20 w-full">
      <div class="grid lg:grid-cols-2 gap-12 items-center">

        <!-- Left: identity -->
        <div>
          <!-- Group badge -->
          <div class="inline-block bg-black text-white border-4 border-black px-4 py-1 font-black text-xs uppercase tracking-[0.2em] mb-6 -rotate-1 shadow-neo">
            {mbti.group}
          </div>

          <!-- Big type -->
          <div class="flex items-end gap-4 mb-2">
            <h1 class="font-black text-[8rem] sm:text-[10rem] leading-none uppercase tracking-tighter text-black"
              style="text-shadow: 6px 6px 0 rgba(0,0,0,0.15)">
              {mbti.type}
            </h1>
          </div>

          <!-- Emoji + label row -->
          <div class="flex items-center gap-4 mb-4">
            <span class="text-6xl">{mbti.emoji}</span>
            <div>
              <div class="font-black text-3xl uppercase leading-none">{mbti.label}</div>
            </div>
          </div>

          <!-- Tagline -->
          <div class="inline-block bg-black text-white border-4 border-black px-5 py-3 font-black text-xl rotate-1 shadow-neo-md mt-2">
            "{mbti.tagline}"
          </div>
        </div>

        <!-- Right: letter breakdown -->
        <div class="grid grid-cols-2 gap-4">
          {mbti.letters.map((l) => (
            <div class="bg-white border-4 border-black p-6 shadow-neo-md hover:-translate-y-1 hover:shadow-neo-lg transition-all">
              <div class="font-black text-7xl leading-none text-black mb-2">{l.letter}</div>
              <div class="font-black text-sm uppercase tracking-widest text-black mb-1">{l.full}</div>
              <div class="w-12 h-1 bg-black mb-2"></div>
              <div class="font-bold text-sm text-black/70">{l.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── OVERVIEW + TRAITS ────────────────────────────────────────── -->
  <section class="bg-white border-b-4 border-black py-20 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-3 gap-8 items-start">

        <!-- Overview text -->
        <div class="lg:col-span-2">
          <div class="inline-block bg-black text-white px-4 py-1 font-black text-xs uppercase tracking-widest mb-6">
            Who is {mbti.type}?
          </div>
          <p class="text-2xl font-bold leading-relaxed text-black">
            {mbti.overview}
          </p>
        </div>

        <!-- Traits grid -->
        <div>
          <div class="font-black text-xs uppercase tracking-widest mb-4 text-black/50">Key Traits</div>
          <div class="flex flex-wrap gap-2">
            {mbti.traits.map((trait) => (
              <span
                class="border-4 border-black px-3 py-2 font-black text-sm uppercase tracking-wide shadow-neo hover:-translate-y-0.5 hover:shadow-neo-md transition-all"
                style={`background-color: ${mbti.colorHex}`}
              >
                {trait}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── STRENGTHS & GROWTH ──────────────────────────────────────── -->
  <section class="border-b-4 border-black py-20 px-4" style={`background-color: ${mbti.colorHex}`}>
    <!-- dot pattern -->
    <div
      class="absolute inset-0 pointer-events-none opacity-10"
      style="background-image: radial-gradient(#000 1.5px, transparent 1.5px); background-size: 28px 28px;"
    ></div>
    <div class="relative max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-black text-5xl uppercase leading-none">
          The Full Picture
        </h2>
        <div class="w-24 h-2 bg-black mx-auto mt-4"></div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Strengths -->
        <div class="bg-white border-4 border-black p-8 shadow-neo-lg">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-black flex items-center justify-center flex-shrink-0">
              <CheckCircle className="w-5 h-5 text-white" />
            </div>
            <h3 class="font-black text-2xl uppercase">Strengths</h3>
          </div>
          <ul class="space-y-4">
            {mbti.strengths.map((s) => (
              <li class="flex items-start gap-3">
                <span class="font-black text-lg leading-none mt-0.5 flex-shrink-0">→</span>
                <span class="font-bold text-base leading-snug">{s}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Growth -->
        <div class="bg-black border-4 border-black p-8 shadow-neo-lg text-white">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 border-4 border-white flex items-center justify-center flex-shrink-0"
              style={`background-color: ${mbti.colorHex}`}>
              <XCircle className="w-5 h-5 text-black" />
            </div>
            <h3 class="font-black text-2xl uppercase text-white">Growth Areas</h3>
          </div>
          <ul class="space-y-4">
            {mbti.growth.map((g) => (
              <li class="flex items-start gap-3">
                <span class="font-black text-lg leading-none mt-0.5 flex-shrink-0 opacity-60">↗</span>
                <span class="font-bold text-base leading-snug text-white/90">{g}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FAMOUS PEOPLE ────────────────────────────────────────────── -->
  <section class="bg-black border-b-4 border-black py-20 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="mb-10">
        <div class="inline-block border-4 px-4 py-1 font-black text-sm uppercase tracking-widest mb-4 rotate-1"
          style={`background-color: ${mbti.colorHex}; border-color: ${mbti.colorHex}`}>
          Famous {mbti.type}s
        </div>
        <h2 class="font-black text-4xl uppercase text-white leading-none">
          You're In Good Company
        </h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {mbti.famous.map((person, i) => (
          <div
            class="border-4 border-black p-6 shadow-neo-md hover:-translate-y-2 hover:shadow-neo-lg transition-all"
            style={`background-color: ${mbti.colorHex}; box-shadow: 8px 8px 0 0 ${mbti.colorHex}50`}
          >
            <!-- Avatar circle -->
            <div
              class="w-16 h-16 border-4 border-black bg-black flex items-center justify-center font-black text-2xl mb-4"
              style={`color: ${mbti.colorHex}`}
            >
              {person.name.charAt(0)}
            </div>
            <div class="font-black text-base uppercase leading-tight">{person.name}</div>
            <div class="font-bold text-xs text-black/60 mt-1 leading-tight">{person.role}</div>
            <div class="mt-3 inline-block bg-black text-white px-2 py-0.5 font-black text-[10px] uppercase tracking-wider">
              {mbti.type}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── COMPATIBLE TYPES ─────────────────────────────────────────── -->
  <section class="bg-neo-bg border-b-4 border-black py-20 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <!-- Best matches -->
        <div>
          <div class="inline-block bg-black text-white px-4 py-1 font-black text-xs uppercase tracking-widest mb-4">
            Best Vibes With
          </div>
          <h2 class="font-black text-4xl uppercase leading-none mb-6">
            Your People
          </h2>
          <div class="flex flex-col gap-3">
            {mbti.compatible.map((type) => (
              <a
                href={`/mbti/${type}`}
                class="group flex items-center gap-4 border-4 border-black p-4 shadow-neo hover:-translate-y-1 hover:shadow-neo-md transition-all"
                style={`background-color: ${mbtiHexMap[type] || "#fff"}`}
              >
                <div class="font-black text-3xl w-10 text-center">
                  {mbtiEmojis[type] || "✨"}
                </div>
                <div>
                  <div class="font-black text-xl uppercase">{type}</div>
                  <div class="font-bold text-sm text-black/70">{mbtiLabelMap[type]}</div>
                </div>
                <div class="ml-auto border-4 border-black bg-black text-white px-3 py-1 font-black text-xs uppercase group-hover:bg-white group-hover:text-black transition-colors">
                  View →
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- All types grid -->
        <div>
          <div class="inline-block bg-black text-white px-4 py-1 font-black text-xs uppercase tracking-widest mb-4">
            All 16 Types
          </div>
          <h2 class="font-black text-4xl uppercase leading-none mb-6">
            Explore More
          </h2>
          <div class="grid grid-cols-4 gap-2">
            {allTypes.map((type) => (
              <a
                href={`/mbti/${type}`}
                class={`border-4 border-black py-3 text-center font-black text-sm uppercase shadow-neo hover:-translate-y-0.5 hover:shadow-neo-md transition-all ${type === mbti.type ? "ring-4 ring-offset-2 ring-black" : ""}`}
                style={`background-color: ${mbtiHexMap[type]}`}
              >
                {type}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── ON HANGOUT! ──────────────────────────────────────────────── -->
  <section
    class="border-b-4 border-black py-20 px-4 relative overflow-hidden"
    style={`background-color: ${mbti.colorHex}`}
  >
    <div
      class="absolute inset-0 pointer-events-none opacity-10"
      style="background-image: radial-gradient(#000 1.5px, transparent 1.5px); background-size: 28px 28px;"
    ></div>
    <div class="relative max-w-7xl mx-auto">
      <div class="max-w-2xl mx-auto">
        <div class="inline-block bg-black text-white px-4 py-1 font-black text-xs uppercase tracking-widest mb-4 -rotate-1">
          {mbti.type} on Hangout!
        </div>
        <h2 class="font-black text-5xl uppercase leading-none mb-6">
          How You<br />Hangout
        </h2>
        <div class="bg-white border-4 border-black p-6 shadow-neo-lg">
          <div class="text-4xl mb-3">{mbti.emoji}</div>
          <p class="font-bold text-lg leading-relaxed">
            {mbti.hangoutStyle}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CTA ──────────────────────────────────────────────────────── -->
  <section class="bg-black py-24 px-4 text-white relative overflow-hidden">
    <!-- Decorative noise lines -->
    <div class="absolute inset-0 pointer-events-none opacity-5"
      style="background-image: repeating-linear-gradient(0deg, #fff 0px, #fff 1px, transparent 1px, transparent 30px);">
    </div>

    <!-- Large decorative type in background -->
    <div class="absolute right-8 top-1/2 -translate-y-1/2 font-black text-[200px] leading-none uppercase text-white/5 select-none pointer-events-none hidden lg:block">
      {mbti.type}
    </div>

    <div class="relative max-w-7xl mx-auto text-center">
      <div
        class="inline-block border-4 border-black px-4 py-1 font-black text-sm uppercase tracking-widest mb-6 -rotate-1"
        style={`background-color: ${mbti.colorHex}; color: #000`}
      >
        🇸🇬 Students Only
      </div>
      <h2 class="font-black text-6xl md:text-8xl uppercase leading-none mb-4">
        Show Up<br />
        <span
          class="border-4 border-black px-4 inline-block rotate-1"
          style={`background-color: ${mbti.colorHex}; color: #000`}
        >
          As You Are.
        </span>
      </h2>
      <p class="text-xl font-bold text-white/80 max-w-xl mx-auto mb-10">
        Join the waitlist and get matched with communities that actually fit your vibe, as an {mbti.type}.
      </p>
      <button
        class="open-waitlist inline-flex items-center gap-3 border-4 border-white font-black text-xl uppercase px-8 py-5 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all shadow-[8px_8px_0_0_white] cursor-pointer"
        style={`background-color: ${mbti.colorHex}; color: #000`}
      >
        <Zap className="w-6 h-6 fill-black" />
        Join the Waitlist
      </button>
      <div class="mt-8 text-white/40 font-bold text-sm uppercase tracking-widest">
        Free · Verified Students Only · No Spam
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Override body background for this page */
  body {
    background-color: #fffdf5;
  }
</style>

<script>
  const modal = document.getElementById("waitlist-modal") as HTMLDialogElement;
  const openBtns = document.querySelectorAll(".open-waitlist");
  const closeBtn = document.getElementById("close-waitlist");
  const form = document.getElementById("waitlist-form") as HTMLFormElement;
  const success = document.getElementById("waitlist-success");
  const emailInput = document.getElementById(
    "waitlist-email",
  ) as HTMLInputElement;

  openBtns.forEach((btn) =>
    btn.addEventListener("click", () => modal?.showModal()),
  );
  closeBtn?.addEventListener("click", () => modal?.close());
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = emailInput?.value || "";
    if (!email.toLowerCase().endsWith(".edu.sg")) {
      emailInput.style.borderColor = "#FF6B6B";
      emailInput.style.background = "#fff0f0";
      emailInput.value = "";
      emailInput.placeholder = "⚠️ Must be a .edu.sg school email!";
      setTimeout(() => {
        emailInput.style.borderColor = "";
        emailInput.style.background = "";
        emailInput.placeholder = "yourname@school.edu.sg";
      }, 3000);
      return;
    }

    try {
      // Gather selected communities
      const selectedCommunities = Array.from(
        document.querySelectorAll('input[name="communities"]:checked'),
      ).map((cb: any) => cb.value);

      const customCommInput = document.getElementById(
        "custom-community",
      ) as HTMLInputElement;
      if (customCommInput?.value?.trim()) {
        selectedCommunities.push(customCommInput.value.trim());
      }

      const response = await fetch(
        "https://server.hangoutstudios.com/api/waitlist",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email,
            communities: selectedCommunities,
          }),
        },
      );

      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        const message =
          typeof payload?.message === "string"
            ? payload.message
            : "Something went wrong. Try again.";
        throw new Error(message);
      }

      form.classList.add("hidden");
      success?.classList.remove("hidden");
    } catch (error) {
      const message =
        error instanceof Error && error.message
          ? error.message
          : "Something went wrong. Try again.";

      emailInput.style.borderColor = "#FF6B6B";
      emailInput.style.background = "#fff0f0";
      emailInput.value = "";
      emailInput.placeholder = `⚠️ ${message}`;
      setTimeout(() => {
        emailInput.style.borderColor = "";
        emailInput.style.background = "";
        emailInput.placeholder = "yourname@school.edu.sg";
      }, 3000);
    }
  });

  // Footer contact / volunteer form
  const footerContactForm = document.getElementById(
    "footer-contact-form",
  ) as HTMLFormElement;
  const footerContactSuccess = document.getElementById(
    "footer-contact-success",
  );

  footerContactForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(footerContactForm);
    const payload = {
      name: String(formData.get("name") || ""),
      email: String(formData.get("email") || ""),
      type: String(formData.get("type") || ""),
      message: String(formData.get("message") || ""),
    };

    try {
      const response = await fetch(
        "https://server.hangoutstudios.com/api/contact",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        },
      );

      if (!response.ok) throw new Error("Contact submission failed");

      footerContactForm.classList.add("hidden");
      footerContactSuccess?.classList.remove("hidden");
    } catch (error) {
      alert("Something went wrong. Please try again.");
    }
  });

  // Mobile menu toggle
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  menuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("max-h-0");
    mobileMenu?.classList.toggle("opacity-0");
    mobileMenu?.classList.toggle("max-h-96");
    mobileMenu?.classList.toggle("opacity-100");
  });

  // Personality card hover effect - highlight matching communities
  const personalityCards = document.querySelectorAll(".personality-card");
  personalityCards.forEach((card) => {
    card.addEventListener("click", () => {
      personalityCards.forEach((c) =>
        c.classList.remove("ring-4", "ring-black", "ring-offset-2"),
      );
      card.classList.add("ring-4", "ring-black", "ring-offset-2");
    });
  });
</script>
